{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalDependencies": [
    "patches/**",
    "bunfig.toml",
    ".npmrc",
    ".github/actions/setup-bun/**",
    ".github/workflows/test.yml",
    "package.json"
  ],
  "globalEnv": ["CI", "OPENBNK_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "OPENBNK_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "@openbnk/cli#typecheck": {
      "dependsOn": ["@openbnk/core#typecheck"]
    },
    "test:components": {
      "outputs": [],
      "cache": false
    },
    "@openbnk/sdk#typecheck": {
      "dependsOn": ["@openbnk/core#typecheck"]
    },
    "@openbnk/server#typecheck": {
      "dependsOn": ["@openbnk/core#typecheck"]
    },
    "@openbnk/simulation#typecheck": {
      "dependsOn": ["@openbnk/core#typecheck"]
    },
    "@openbnk/tui#typecheck": {
      "dependsOn": ["@openbnk/core#typecheck"]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["dist/**"]
    },
    // Workspace packages export their sources, so tests never wait for a dependency's build; the build job in
    // test.yml checks the library builds. No package has a transit script: it runs nothing and only folds every
    // workspace dependency into the test hash.
    "transit": {
      "dependsOn": ["^transit"]
    },
    // Every package with a test script runs here, so a new suite cannot be left out of CI.
    "test": {
      "dependsOn": ["transit"],
      "outputs": []
    },
    "@openbnk/desktop#test": {
      "outputs": [],
      "cache": false
    },
    "@openbnk/sdk#verify:package": {
      "outputs": []
    }
  }
}
