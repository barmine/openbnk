{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.1.1",
  "name": "@openbnk/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/openbnk.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./workerd": "./src/workerd.ts",
    "./workerd/effect": "./src/effect/workerd.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "tsc -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@openbnk/client": "workspace:*",
    "@openbnk/core": "workspace:*",
    "@openbnk/plugin": "workspace:*",
    "@openbnk/schema": "workspace:*",
    "@openbnk/server": "workspace:*",
    "@openbnk/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@openbnk/ai": "workspace:*",
    "@openbnk/httpapi-codegen": "workspace:*",
    "@openbnk/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
