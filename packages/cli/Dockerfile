FROM alpine AS base

ARG BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=${BUN_RUNTIME_TRANSPILER_CACHE_PATH}
RUN apk add --no-cache libgcc libstdc++ ripgrep

FROM base AS build-amd64
COPY dist/cli-linux-x64-baseline-musl/bin/openbnk /usr/local/bin/openbnk

FROM base AS build-arm64
COPY dist/cli-linux-arm64-musl/bin/openbnk /usr/local/bin/openbnk

ARG TARGETARCH
FROM build-${TARGETARCH}
RUN ln -s openbnk /usr/local/bin/openbnk2 && openbnk --version && openbnk2 --version
ENTRYPOINT ["openbnk"]
