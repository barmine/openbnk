#!/usr/bin/env bash
# openbnk installer: clones (or updates) the source, builds a native binary, and puts it on your PATH.
#
#   bash <(gh api repos/christ-pher/openbnk/contents/install -H "Accept: application/vnd.github.raw")
#   ./install                      # from an existing checkout
#
# Re-run it any time to update. Environment overrides:
#   OPENBNK_REPO     git URL or owner/name to clone      (default: christ-pher/openbnk)
#   OPENBNK_SRC      where the source checkout lives     (default: ~/.local/share/openbnk/src)
#   OPENBNK_BIN_DIR  where the binary is installed       (default: ~/.local/bin)
#   OPENBNK_BRANCH   branch to build                     (default: main)
set -euo pipefail

REPO=${OPENBNK_REPO:-christ-pher/openbnk}
SRC=${OPENBNK_SRC:-$HOME/.local/share/openbnk/src}
BIN_DIR=${OPENBNK_BIN_DIR:-$HOME/.local/bin}
BRANCH=${OPENBNK_BRANCH:-main}
BUN_VERSION=1.4.2

say() { printf '\033[38;5;214m==>\033[0m %s\n' "$*"; }
die() { printf '\033[0;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

case "$(uname -s)" in
  Linux | Darwin) ;;
  *) die "unsupported OS: $(uname -s) (Linux and macOS only)" ;;
esac
for tool in git curl unzip; do command -v "$tool" >/dev/null || die "missing required tool: $tool"; done

# Bun is the build toolchain; install the pinned version if missing or different.
export BUN_INSTALL=${BUN_INSTALL:-$HOME/.bun}
export PATH="$BUN_INSTALL/bin:$PATH"
if [ "$(bun --version 2>/dev/null || true)" != "$BUN_VERSION" ]; then
  say "installing bun $BUN_VERSION"
  curl -fsSL https://bun.sh/install | bash -s "bun-v$BUN_VERSION" >/dev/null
fi

# Use the checkout this script lives in, if run from one; otherwise clone or update $SRC.
here=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || true)
if [ -n "$here" ] && [ -f "$here/packages/cli/script/build.ts" ]; then
  SRC=$here
  say "building from checkout $SRC"
elif [ -d "$SRC/.git" ]; then
  say "updating $SRC"
  git -C "$SRC" fetch --quiet origin "$BRANCH"
  git -C "$SRC" checkout --quiet "$BRANCH"
  git -C "$SRC" reset --quiet --hard "origin/$BRANCH"
else
  say "cloning $REPO into $SRC"
  mkdir -p "$(dirname "$SRC")"
  if [[ "$REPO" != *:* && "$REPO" != */*/* ]] && command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    gh repo clone "$REPO" "$SRC" -- --quiet --branch "$BRANCH"
  else
    url=$REPO
    [[ "$url" == *:* ]] || url="https://github.com/$REPO.git"
    git clone --quiet --branch "$BRANCH" "$url" "$SRC"
  fi
fi

say "installing dependencies"
(cd "$SRC" && bun install --frozen-lockfile >/dev/null 2>&1) || (cd "$SRC" && bun install --frozen-lockfile)

say "building openbnk (takes a minute or two)"
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
# Version is VERSION plus the commit, e.g. 0.1.0+6307a22. The channel stays the branch name, which
# keeps the session database and background service the same as earlier builds of that branch.
version="$(tr -d '[:space:]' <"$SRC/VERSION")+$(git -C "$SRC" rev-parse --short HEAD)"
channel=$(git -C "$SRC" branch --show-current | sed 's/[^a-zA-Z0-9._-]/-/g')
(cd "$SRC/packages/cli" && OPENBNK_VERSION=$version OPENBNK_CHANNEL=${channel:-detached} \
  bun run script/build.ts --single --skip-install "--outdir=$out" >"$out/build.log" 2>&1) ||
  { tail -n 40 "$out/build.log" >&2; die "build failed"; }
binary=$(find "$out" -path '*/bin/openbnk' -type f | head -n 1)
[ -n "$binary" ] || die "build finished but no binary was produced"

mkdir -p "$BIN_DIR"
install -m 0755 "$binary" "$BIN_DIR/openbnk.new"
mv -f "$BIN_DIR/openbnk.new" "$BIN_DIR/openbnk"
say "installed $("$BIN_DIR/openbnk" --version) to $BIN_DIR/openbnk"

# PATH for new shells: every existing zsh/bash startup file, plus the current shell's (created if
# missing). macOS terminals start bash as a login shell, which reads .bash_profile.
rcs=("$HOME/.zshrc" "$HOME/.bashrc")
[ "$(uname -s)" = Darwin ] && rcs+=("$HOME/.bash_profile")
for rc in "${rcs[@]}"; do
  case "$rc:${SHELL:-}" in
    */.zshrc:*/zsh | */.bashrc:*/bash | */.bash_profile:*/bash) ;;
    *) [ -f "$rc" ] || continue ;;
  esac
  if ! grep -qs "$BIN_DIR" "$rc"; then
    printf '\nexport PATH="%s:$PATH"\n' "$BIN_DIR" >>"$rc"
    say "added $BIN_DIR to PATH in $rc"
  fi
  # zsh caches the command list; this makes completion notice newly installed commands by itself.
  if [[ "$rc" == */.zshrc ]] && ! grep -qs "completion:\*' rehash true" "$rc"; then
    printf "zstyle ':completion:*' rehash true\n" >>"$rc"
  fi
done

# The terminal running this script keeps its old PATH. If BIN_DIR isn't on it, also link openbnk into
# a writable directory that is, so the command works here right away. Never replace a different file.
case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *)
    for dir in /opt/homebrew/bin /usr/local/bin "$HOME/bin"; do
      case ":$PATH:" in *":$dir:"*) ;; *) continue ;; esac
      [ -w "$dir" ] || continue
      [ ! -e "$dir/openbnk" ] || [ "$(readlink "$dir/openbnk")" = "$BIN_DIR/openbnk" ] || continue
      ln -sf "$BIN_DIR/openbnk" "$dir/openbnk"
      say "linked $dir/openbnk so it works in this terminal now"
      break
    done
    ;;
esac

# First install only: ask which model server to use and save it to the global config.
# OPENBNK_BASE_URL skips the question; an existing config file is never touched. With no answer,
# nothing is saved and openbnk falls back to OPENBNK_BASE_URL at run time.
CONFIG_FILE=${XDG_CONFIG_HOME:-$HOME/.config}/openbnk/openbnk.json
server=${OPENBNK_BASE_URL:-}
if [ ! -f "$CONFIG_FILE" ]; then
  if [ -z "$server" ] && [ -r /dev/tty ] && { : </dev/tty; } 2>/dev/null; then
    printf '\033[38;5;214m==>\033[0m OpenAI-compatible model server URL (e.g. http://my-server:8080/v1): ' >/dev/tty
    read -r server </dev/tty || true
  fi
  if [ -n "$server" ]; then
    server=${server%/}
    [[ "$server" == */v1 ]] || server="$server/v1"
    curl -fsS --max-time 5 "$server/models" >/dev/null 2>&1 ||
      printf '\033[0;33mwarning:\033[0m %s/models did not answer; saving it anyway\n' "$server" >&2
    mkdir -p "$(dirname "$CONFIG_FILE")"
    printf '{ "provider": { "bnk": { "options": { "baseURL": "%s" } } } }\n' "$server" >"$CONFIG_FILE"
    say "saved model server $server to $CONFIG_FILE"
  fi
fi
server=$(grep -o '"baseURL"[^,}]*' "$CONFIG_FILE" 2>/dev/null | sed 's/.*: *"\(.*\)"/\1/')

cat <<EOF

Done. Run \`openbnk\` in a project directory to start.
  Model server: ${server:-not set} (set: provider.bnk.options.baseURL in $CONFIG_FILE, or OPENBNK_BASE_URL)
  Learning:     openbnk learn list | memory | undo <id> | accept <id> | off
  Update:       ./update.sh   (from your openbnk checkout)
EOF
# zsh only rescans commands for tab completion when told to; new terminals already pick it up.
[[ "${SHELL:-}" == */zsh ]] && echo "  Tab completion in this terminal: run \`rehash\` once (new terminals work as-is)."
true
