#!/usr/bin/env bash
# openbnk installer: clones (or updates) the source, builds a native binary, and puts it on your PATH.
#
#   bash <(gh api repos/christ-pher/openbnk/contents/install -H "Accept: application/vnd.github.raw")
#   ./install                      # from an existing checkout
#
# Re-run it any time to update. Environment overrides:
#   OPENBNK_REPO     git URL or owner/name to clone      (default: christ-pher/openbnk)
#   OPENBNK_SRC      where the source checkout lives     (default: ~/.local/share/openbnk/src)
#   OPENBNK_BIN_DIR  where the binary is installed       (default: ~/.local/bin)
#   OPENBNK_BRANCH   branch to build                     (default: main)
set -euo pipefail

REPO=${OPENBNK_REPO:-christ-pher/openbnk}
SRC=${OPENBNK_SRC:-$HOME/.local/share/openbnk/src}
BIN_DIR=${OPENBNK_BIN_DIR:-$HOME/.local/bin}
BRANCH=${OPENBNK_BRANCH:-main}
BUN_VERSION=1.4.2

say() { printf '\033[38;5;214m==>\033[0m %s\n' "$*"; }
die() { printf '\033[0;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

case "$(uname -s)" in
  Linux | Darwin) ;;
  *) die "unsupported OS: $(uname -s) (Linux and macOS only)" ;;
esac
for tool in git curl unzip; do command -v "$tool" >/dev/null || die "missing required tool: $tool"; done

# Bun is the build toolchain; install the pinned version if missing or different.
export BUN_INSTALL=${BUN_INSTALL:-$HOME/.bun}
export PATH="$BUN_INSTALL/bin:$PATH"
if [ "$(bun --version 2>/dev/null || true)" != "$BUN_VERSION" ]; then
  say "installing bun $BUN_VERSION"
  curl -fsSL https://bun.sh/install | bash -s "bun-v$BUN_VERSION" >/dev/null
fi

# Use the checkout this script lives in, if run from one; otherwise clone or update $SRC.
here=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" 2>/dev/null && pwd || true)
if [ -n "$here" ] && [ -f "$here/packages/cli/script/build.ts" ]; then
  SRC=$here
  say "building from checkout $SRC"
elif [ -d "$SRC/.git" ]; then
  say "updating $SRC"
  git -C "$SRC" fetch --quiet origin "$BRANCH"
  git -C "$SRC" checkout --quiet "$BRANCH"
  git -C "$SRC" reset --quiet --hard "origin/$BRANCH"
else
  say "cloning $REPO into $SRC"
  mkdir -p "$(dirname "$SRC")"
  if [[ "$REPO" != *:* && "$REPO" != */*/* ]] && command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    gh repo clone "$REPO" "$SRC" -- --quiet --branch "$BRANCH"
  else
    url=$REPO
    [[ "$url" == *:* ]] || url="https://github.com/$REPO.git"
    git clone --quiet --branch "$BRANCH" "$url" "$SRC"
  fi
fi

say "installing dependencies"
(cd "$SRC" && bun install --frozen-lockfile >/dev/null 2>&1) || (cd "$SRC" && bun install --frozen-lockfile)

say "building openbnk (takes a minute or two)"
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
(cd "$SRC/packages/cli" && bun run script/build.ts --single --skip-install "--outdir=$out" >"$out/build.log" 2>&1) ||
  { tail -n 40 "$out/build.log" >&2; die "build failed"; }
binary=$(find "$out" -path '*/bin/openbnk' -type f | head -n 1)
[ -n "$binary" ] || die "build finished but no binary was produced"

mkdir -p "$BIN_DIR"
install -m 0755 "$binary" "$BIN_DIR/openbnk.new"
mv -f "$BIN_DIR/openbnk.new" "$BIN_DIR/openbnk"
say "installed $("$BIN_DIR/openbnk" --version) to $BIN_DIR/openbnk"

case ":$PATH:" in
  *":$BIN_DIR:"*) ;;
  *)
    rc="$HOME/.bashrc"
    case "${SHELL:-}" in */zsh) rc="$HOME/.zshrc" ;; esac
    if ! grep -qs "$BIN_DIR" "$rc"; then
      printf '\nexport PATH="%s:$PATH"\n' "$BIN_DIR" >>"$rc"
      say "added $BIN_DIR to PATH in $rc (open a new shell)"
    fi
    ;;
esac

cat <<EOF

Done. Run \`openbnk\` in a project directory to start.
  Model server: http://10.0.75.254:8080/v1 (override: provider.bnk.options.baseURL in ~/.config/openbnk/openbnk.json)
  Learning:     openbnk learn list | memory | undo <id> | accept <id> | off
  Update:       re-run this installer
EOF
